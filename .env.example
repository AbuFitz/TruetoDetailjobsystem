# Supabase project connection (Project Settings → API).
# VITE_SUPABASE_ANON_KEY is safe to expose to the browser — it only works
# through Row Level Security + the security-definer RPCs defined in
# supabase/migrations. Never put a service_role key in a VITE_ variable.
# Must be the SAME project as the main site's NEXT_PUBLIC_SUPABASE_URL/
# NEXT_PUBLIC_SUPABASE_ANON_KEY — see README → "Cross-site login (SSO)".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cross-subdomain SSO: scopes the session cookie to the parent domain so
# truetodetail.co.uk and this app (e.g. app.truetodetail.co.uk) share one
# sign-in. Leave unset for local dev / any deploy not on that domain yet —
# the cookie then just scopes to whatever host is actually serving the app.
# Note the leading dot.
VITE_AUTH_COOKIE_DOMAIN=.truetodetail.co.uk

# OpenRouteService API key — powers real, routing-based ETAs and the
# travel-time gaps on the admin schedule (get-eta / get-travel-time Edge
# Functions). Free tier: https://openrouteservice.org/dev/#/signup
# Without this, the app falls back to the honest on-track/running-behind
# comparison and a straight-line travel estimate — nothing breaks.
ORS_API_KEY=
